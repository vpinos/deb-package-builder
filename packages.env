# What this repo builds: one upstream release tag per package, plus our own
# packaging revision. This file is the only place they're set.
#
# Pushing a change to this file (on master) runs "Build Debian packages",
# which builds only the packages whose resulting version isn't in the VPinOS
# apt repo yet (vpinos/deb-repo), and puts just those in a new release
# vpinos-debs-<run number>. Then publish that release with deb-repo's
# "Update apt repository" (source_repo=vpinos/deb-package-builder).
#
#   New upstream release      -> change <PKG>_TAG, reset <PKG>_REVISION to 1
#   Packaging fix, same tag   -> raise <PKG>_REVISION by 1
#
# Package version = upstream tag without the leading "v" + "-" + revision
# (vpinball also gets an epoch: 1:<tag>-<revision>). VPinOS installations
# only take a higher version, so never lower a revision or go back to an
# older tag without raising the revision; scripts/plan.sh refuses to.
# More: README.md, and notes/publishing.md in the vpinos repo.

# Visual Pinball standalone player (superhac/vpinball release assets)
VPINBALL_TAG=v10.8.1-6192-98c18ac7f
VPINBALL_REVISION=4

# VPinFE frontend (superhac/vpinfe release assets, slim builds)
VPINFE_TAG=v2.6.6
VPINFE_REVISION=4

# VPXConfig (vpinos/vpxconfig release assets)
VPXCONFIG_TAG=v0.5.8
VPXCONFIG_REVISION=4

# WiVRn (superhac/WiVRn): upstream's own .debs, republished as-is, so the
# version comes from the .deb itself and there is no revision here.
WIVRN_TAG=v26.9-trixie

# xrizer (Supreeeme/xrizer): built from the tagged source
XRIZER_TAG=v0.6
XRIZER_REVISION=4
